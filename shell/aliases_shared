# tmux — socket-per-session helpers (pairable via /tmp/<name>)
function tmux_private() {
  chmod 700 /tmp/$1
}

# After detach: re-secure a live session, sweep the socket of a dead one
function _tmux_cleanup() {
  if ps -o ruser,command -ax | grep -q "[n]ew-session -s $1" ; then
    tmux_private $1
  else
    rm -f /tmp/$1
    echo "Deleted unused session ($1)"
  fi
}

# Attach or create — the daily driver
function tmux_join() {
  if [ -z "$1" ]; then echo "Usage: tmuxj <name>  (attach or create)"; return 1; fi
  tmux -S /tmp/$1 new-session -s $1 -d 2>/dev/null && tmux_private $1
  tmux -S /tmp/$1 attach -t $1
  _tmux_cleanup $1
}

function tmux_new() {
  if [ -z "$1" ]; then echo "Usage: tmuxn <name>"; return 1; fi
  if [ -S /tmp/$1 ]; then echo "Session '$1' already exists — tmuxj $1 to attach"; return 1; fi
  tmux_join $1
}

# Attach only — fails if the session doesn't exist
function tmux_attach() {
  if [ -z "$1" ]; then echo "Usage: tmuxa <name>"; return 1; fi
  if [ ! -S /tmp/$1 ]; then echo "No session '$1' (tmuxl to list, tmuxj to create)"; return 1; fi
  tmux -S /tmp/$1 attach -t $1
  _tmux_cleanup $1
}

function tmux_kill() {
  if [ -z "$1" ]; then echo "Usage: tmuxk <name>"; return 1; fi
  tmux -S /tmp/$1 kill-session -t $1 2>/dev/null
  rm -f /tmp/$1
  echo "Killed session ($1)"
}

function tmux_toggle() {
  local socket
  if [ -n "$1" ]; then
    socket=/tmp/$1
  elif [ -n "$TMUX" ]; then
    socket=${TMUX%%,*}
  else
    echo "Usage: tmuxp <name>  (or run inside a session)"; return 1
  fi
  if [ "$(stat -f %Lp $socket)" = "777" ]; then
    chmod 700 $socket && echo "private: $socket"
  else
    chmod 777 $socket && echo "PUBLIC: $socket"
  fi
}

function tmux_list () {
  ps -o ruser,command -ax | grep '[n]ew-session -s' | ruby -ne '$_ =~ /^(\w+).*-s (\w+)/; puts "#{$1} started #{$2}"'
}

alias tmuxn='tmux_new'
alias tmuxl='tmux_list'
alias tmuxp='tmux_toggle'
alias tmuxa='tmux_attach'
alias tmuxj='tmux_join'
alias tmuxk='tmux_kill'
alias pair="tmuxj pair"

alias newmux="tmux new-session -s"
